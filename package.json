{
  "name": "garuda-code",
  "version": "0.1.0",
  "description": "Garuda Code — a multi-provider, tool-using AI coding agent for the terminal.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/adarsh22-dev/garuda-code.git"
  },
  "homepage": "https://github.com/adarsh22-dev/garuda-code",
  "bugs": {
    "url": "https://github.com/adarsh22-dev/garuda-code/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "garuda": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": ["dist", "README.md", "LICENSE", "SECURITY.md", "docs"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "cli": "tsx src/index.ts",
    "setup": "tsx src/index.ts providers setup",
    "link": "npm run build && npm link",
    "prepublishOnly": "npm run build && npm audit --omit=dev"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": ["ai", "cli", "agent", "coding-assistant", "anthropic", "llm"],
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "commander": "^12.1.0",
    "chalk": "^5.3.0",
    "ink": "^5.0.1",
    "ink-text-input": "^6.0.0",
    "react": "^18.3.1",
    "openai": "^4.70.0",
    "glob": "^11.0.0",
    "nanoid": "^5.0.9",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "typescript": "^5.6.3",
    "tsx": "^4.19.2"
  }
}
